# Copy to .env (git-ignored) and fill in what you have. Every key is optional.
# Sources that need a missing key show "Not configured" in the results table.

PORT=3000
HOST=0.0.0.0

# --- Optional API keys -------------------------------------------------------
# Have I Been Pwned v3 (paid; the free tier does not include breachedaccount)
HIBP_API_KEY=
# LeakCheck Pro API v2. Without a key the keyless public API is used instead.
LEAKCHECK_API_KEY=
# Numverify (apilayer): free plan 100 requests/month
NUMVERIFY_API_KEY=

# --- Optional self-hosted services -------------------------------------------
# PhoneInfoga running in REST mode: `phoneinfoga serve -p 5000`
PHONEINFOGA_URL=

# --- Tuning -------------------------------------------------------------------
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
SOURCE_TIMEOUT_MS=25000
CLI_TIMEOUT_MS=240000
MAIGRET_TOP_SITES=100
SHERLOCK_TIMEOUT_SEC=10
CACHE_TTL_MS=600000
DEFAULT_COUNTRY=US
# Set to 1 when running behind a reverse proxy so per-IP rate limiting sees client IPs
TRUST_PROXY=0

# --- Local paths ----------------------------------------------------------------
LOG_FILE=./data/queries.log
DATA_DIR=./data
